{
  "name": "dsh-connect",
  "version": "0.7.2",
  "description": "Channel-agnostic messaging bridge core for DeepSeek Harness (DSH): binds chat channels to DSH agents, streams replies, and pushes work summaries",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./binding": {
      "types": "./lib/binding.d.ts",
      "default": "./lib/binding.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "dingtalk",
    "ai-agent",
    "chatbot",
    "cordis",
    "messaging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IvanWu2015/dsh-connect.git",
    "directory": "packages/connect"
  },
  "homepage": "https://github.com/IvanWu2015/dsh-connect",
  "bugs": {
    "url": "https://github.com/IvanWu2015/dsh-connect/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.6.3"
  }
}
