{
    "name":  "dsh-connect-web",
    "version":  "0.6.3",
    "description":  "Web channel adapter for dsh-connect: mirrors Feishu conversations to DSH Web GUI",
    "type":  "module",
    "main":  "./lib/index.js",
    "types":  "./lib/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "import":  "./lib/index.js"
                          }
                },
    "files":  [
                  "lib",
                  "README.md",
                  "README.zh.md",
                  "README.i18n.yaml"
              ],
    "scripts":  {
                    "build":  "tsc",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node test/unit.test.mjs"
                },
    "dependencies":  {
                         "@deepseek-ai/cordis":  "^4.0.1",
                         "@deepseek-ai/schemastery":  "^3.18.1",
                         "dsh-connect":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.15.0",
                            "typescript":  "^5.6.3"
                        },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "web",
                     "mirror",
                     "chatbot"
                 ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/IvanWu2015/dsh-connect.git",
                       "directory":  "packages/connect-web"
                   },
    "homepage":  "https://github.com/IvanWu2015/dsh-connect",
    "bugs":  {
                 "url":  "https://github.com/IvanWu2015/dsh-connect/issues"
             }
}