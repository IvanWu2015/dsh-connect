{
  "name": "dsh-connect-all",
  "version": "0.7.2",
  "description": "All-in-one single-install bundle for dsh-connect: one plugin, one config block, loads the feishu/telegram/dingtalk/web channel adapters behind a channels[] setting",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "client",
    "examples",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "channel",
    "adapter",
    "all-in-one",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IvanWu2015/dsh-connect.git",
    "directory": "packages/connect-all"
  },
  "homepage": "https://github.com/IvanWu2015/dsh-connect",
  "bugs": {
    "url": "https://github.com/IvanWu2015/dsh-connect/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run-all.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-connect-feishu": "^0.7.2",
    "dsh-connect-telegram": "^0.7.2",
    "dsh-connect-dingtalk": "^0.7.2",
    "dsh-connect-web": "^0.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-connect": "^0.7.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-connect": "workspace:*",
    "dsh-connect-feishu": "workspace:*",
    "dsh-connect-telegram": "workspace:*",
    "dsh-connect-dingtalk": "workspace:*",
    "dsh-connect-web": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "^5.6.3"
  }
}
